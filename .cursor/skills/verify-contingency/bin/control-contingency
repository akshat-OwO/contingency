#!/usr/bin/env node

import { spawn } from "node:child_process";
import {
  closeSync,
  existsSync,
  mkdirSync,
  openSync,
  readdirSync,
  readFileSync,
  rmSync,
  writeFileSync,
} from "node:fs";
import { createServer as createHttpServer } from "node:http";
import { createRequire } from "node:module";
import { createConnection, createServer as createNetServer } from "node:net";
import { homedir, tmpdir } from "node:os";
import path from "node:path";
import { setTimeout as delay } from "node:timers/promises";
import { fileURLToPath } from "node:url";

const here = path.dirname(fileURLToPath(import.meta.url));
const skillRoot = path.resolve(here, "..");
const repoRoot = path.resolve(skillRoot, "../../..");
const defaultArtifacts = path.join(skillRoot, "artifacts");
const ecommerceFixturesDir = path.join(skillRoot, "fixtures", "ecommerce");
const instanceName = "instance.json";

const fail = (message, code = 1) => {
  process.stderr.write(`${message}\n`);
  process.exit(code);
};

const usage = () => {
  process.stdout.write(`control-contingency <command>

Commands:
  launch
  doctor
  cleanup
  browser goto --path <path> | --url <absolute-url>
  browser url
  browser resize --width <px> [--height <px>]
  browser mouse --x <px> --y <px> [--click]
  browser canvas-click --x <site-px> --y <site-px>
  browser canvas-type --text <text> [--enter]
  browser input-check --session-id <id>
  browser scroll-check --session-id <id> [--record] [--path <directory>] [--events <n>] [--delta <px>]
  browser click --role <role> --name <name> [--partial]
  browser fill --role <role> --name <name> --value <value> [--partial]
  browser press --key <key> [--role <role> --name <name> [--partial]]
  browser wait --role <role> --name <name> [--has-text <substring>] [--timeout-ms <n>] [--partial]
  browser wait --text <substring> [--timeout-ms <n>] [--partial]
  mcp start
  mcp channels
  mcp call --tool <name> [--params <json>]
  mcp tools [--name <name>]
  mcp resources
  mcp resource --uri <uri>
  mcp stop
  browser snapshot --aria --path <file>
  browser screenshot --path <file>
  browser skills-layout-check --path <directory> [--text-scale <1|2>] [--allow-overflow]
  browser procedure-check --skill-file <file> --path <directory> [--text-scale <1|2>]
  browser set-input-files --label <label> --path <file> | --role <role> --name <name> --path <file>
  browser download --role <role> --name <name> --path <file> [--partial]
  cli -- <contingency args...>
  ecommerce start
  fixture start
  fixture stop

Environment:
  CONTINGENCY_VERIFY_DIR   Isolated run directory (created by launch)
  CONTINGENCY_VERIFY_PORT  Bind port; launch picks a free one otherwise
`);
};

const parseArgs = (argv) => {
  const flags = {};
  const rest = [];
  for (let index = 0; index < argv.length; index += 1) {
    const token = argv[index];
    if (token === "--") {
      rest.push(...argv.slice(index + 1));
      break;
    }
    if (token.startsWith("--")) {
      const key = token.slice(2);
      const next = argv[index + 1];
      if (next === undefined || next.startsWith("--")) {
        flags[key] = true;
      } else {
        flags[key] = next;
        index += 1;
      }
      continue;
    }
    rest.push(token);
  }
  return { flags, rest };
};

const verifyDir = () => {
  const configured = process.env.CONTINGENCY_VERIFY_DIR?.trim();
  if (configured) {
    return path.resolve(configured);
  }
  fail(
    "CONTINGENCY_VERIFY_DIR is unset. Run launch first, then export the printed directory for later commands."
  );
};

const instancePath = (directory = verifyDir()) =>
  path.join(directory, instanceName);

const readInstance = () => {
  const file = instancePath();
  if (!existsSync(file)) {
    fail(`No instance at ${file}. Run launch first.`);
  }
  return JSON.parse(readFileSync(file, "utf8"));
};

const writeInstance = (directory, data) => {
  mkdirSync(directory, { recursive: true });
  writeFileSync(instancePath(directory), `${JSON.stringify(data, null, 2)}\n`);
};

const pidAlive = (pid) => {
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
};

const listenPid = async (port) => {
  const { execFile } = await import("node:child_process");
  const { promisify } = await import("node:util");
  const execFileAsync = promisify(execFile);
  try {
    const { stdout } = await execFileAsync(
      "lsof",
      ["-nP", `-iTCP:${port}`, "-sTCP:LISTEN", "-t"],
      { encoding: "utf8" }
    );
    const pid = Number(stdout.trim().split("\n")[0]);
    return Number.isInteger(pid) && pid > 0 ? pid : undefined;
  } catch {
    return undefined;
  }
};

const portFree = (port, host = "127.0.0.1") =>
  new Promise((resolve) => {
    const socket = createConnection({ host, port });
    socket.once("connect", () => {
      socket.destroy();
      resolve(false);
    });
    socket.once("error", () => {
      resolve(true);
    });
  });

const pickPort = async () => {
  const requested = process.env.CONTINGENCY_VERIFY_PORT?.trim();
  if (requested) {
    const port = Number(requested);
    if (!Number.isInteger(port) || port <= 0) {
      fail(`CONTINGENCY_VERIFY_PORT is not a port: ${requested}`);
    }
    if (!(await portFree(port))) {
      fail(
        `Port ${port} is already listening. Pick another CONTINGENCY_VERIFY_PORT rather than driving a shared instance.`
      );
    }
    return port;
  }
  return await new Promise((resolve, reject) => {
    const server = createNetServer();
    server.once("error", reject);
    server.listen(0, "127.0.0.1", () => {
      const address = server.address();
      if (address === null || typeof address === "string") {
        server.close();
        reject(new Error("Could not bind an ephemeral port."));
        return;
      }
      const { port } = address;
      server.close(() => resolve(port));
    });
  });
};

const playwrightModule = () => {
  const require = createRequire(import.meta.url);
  const candidates = [
    path.join(repoRoot, "packages/cli/node_modules/playwright-core"),
    path.join(repoRoot, "node_modules/playwright-core"),
  ];
  for (const candidate of candidates) {
    if (existsSync(candidate)) {
      return require(candidate);
    }
  }
  fail("playwright-core is not installed. From the repo root run: nub install");
};

const loadPlaywright = () => playwrightModule();

const partialMatch = (flags) =>
  flags.partial === true || flags.partial === "true";

const locator = (page, flags) => {
  const role = flags.role;
  const name = flags.name;
  if (typeof role !== "string" || typeof name !== "string") {
    fail("browser actions that target a control need --role and --name.");
  }
  return page.getByRole(role, { exact: !partialMatch(flags), name });
};

const resolveEvidencePath = (filePath) => {
  if (path.isAbsolute(filePath)) {
    return filePath;
  }
  return path.join(defaultArtifacts, filePath);
};

const resolveInputFilePath = (filePath) => {
  if (path.isAbsolute(filePath)) {
    return filePath;
  }
  const configured = process.env.CONTINGENCY_VERIFY_DIR?.trim();
  if (configured) {
    const fromVerify = path.join(path.resolve(configured), filePath);
    if (existsSync(fromVerify)) {
      return fromVerify;
    }
  }
  const fromArtifacts = path.join(defaultArtifacts, filePath);
  if (existsSync(fromArtifacts)) {
    return fromArtifacts;
  }
  return path.resolve(filePath);
};

const loadEcommercePages = () => {
  if (!existsSync(ecommerceFixturesDir)) {
    fail(`Ecommerce fixtures are missing at ${ecommerceFixturesDir}.`);
  }
  const pages = new Map();
  for (const name of readdirSync(ecommerceFixturesDir)) {
    if (!name.endsWith(".html")) {
      continue;
    }
    pages.set(
      `/${name}`,
      readFileSync(path.join(ecommerceFixturesDir, name), "utf8")
    );
  }
  if (!pages.has("/shop.html")) {
    fail(
      `Ecommerce fixtures must include shop.html under ${ecommerceFixturesDir}.`
    );
  }
  return pages;
};

const runPageAction = async (page, appUrl, action, flags) => {
  switch (action) {
    case "url": {
      return page.url();
    }
    case "goto": {
      const target =
        typeof flags.url === "string"
          ? flags.url
          : new URL(typeof flags.path === "string" ? flags.path : "/", appUrl)
              .href;
      await page.goto(target, { waitUntil: "load" });
      return page.url();
    }
    case "resize": {
      // The Workspace dock has responsive rules, so a drive has to be able to
      // stand at a phone width without launching a second driver.
      const width = Number(flags.width);
      const height = Number(flags.height ?? "844");
      if (!Number.isFinite(width) || !Number.isFinite(height)) {
        throw new Error("browser resize needs --width and --height.");
      }
      await page.setViewportSize({ height, width });
      return `${width}x${height}`;
    }
    case "mouse": {
      // Inspect mode outlines whatever the pointer is over, and its overlay
      // has no accessible name to aim at, so a drive needs raw viewport
      // coordinates over the Workspace canvas.
      const x = Number(flags.x);
      const y = Number(flags.y);
      if (!Number.isFinite(x) || !Number.isFinite(y)) {
        throw new Error("browser mouse needs --x and --y.");
      }
      await page.mouse.move(x, y);
      if (flags.click === true || flags.click === "true") {
        await page.mouse.down();
        await page.mouse.up();
      }
      return `${x},${y}`;
    }
    case "canvas-click": {
      // A user's click on the nested site, given in that site's own CSS
      // pixels and mapped through the live canvas's current scale.
      const x = Number(flags.x);
      const y = Number(flags.y);
      if (!Number.isFinite(x) || !Number.isFinite(y)) {
        throw new Error("browser canvas-click needs --x and --y.");
      }
      const canvas = page.locator('canvas[aria-label="Live browser viewport"]');
      await canvas.waitFor({ state: "visible" });
      const box = await canvas.boundingBox();
      if (box === null) {
        throw new Error("The live browser canvas has no bounds.");
      }
      const dimensions = await canvas.evaluate((element) => ({
        height: element.height,
        width: element.width,
      }));
      if (dimensions.width === 0 || dimensions.height === 0) {
        throw new Error("The live browser canvas has no frame yet.");
      }
      await page.mouse.click(
        box.x + (x * box.width) / dimensions.width,
        box.y + (y * box.height) / dimensions.height
      );
      return `clicked site point ${x},${y}`;
    }
    case "canvas-type": {
      // Keys reach the nested Page while the canvas holds focus.
      const text = String(flags.text ?? "");
      await page.keyboard.type(text);
      if (flags.enter === true || flags.enter === "true") {
        await page.keyboard.press("Enter");
      }
      return `typed ${text.length} characters`;
    }
    case "input-check": {
      const canvas = page.locator('canvas[aria-label="Live browser viewport"]');
      await canvas.waitFor({ state: "visible" });
      const box = await canvas.boundingBox();
      if (box === null) {
        throw new Error("The live browser canvas has no bounds.");
      }
      const dimensions = await canvas.evaluate((element) => ({
        height: element.height,
        width: element.width,
      }));
      if (dimensions.width === 0 || dimensions.height === 0) {
        throw new Error("The live browser canvas has no frame yet.");
      }
      const clickAt = async (x, y) => {
        await page.mouse.click(
          box.x + (x * box.width) / dimensions.width,
          box.y + (y * box.height) / dimensions.height
        );
      };
      await clickAt(180, 324);
      await clickAt(180, 324);
      await clickAt(180, 404);
      // Typed the way a person types: Shift is its own key press around the
      // capitals and symbols, and a typo is corrected with Backspace. Each of
      // these is a separate keyboard input, and none of them may split the
      // one fill the field ends up with (#258).
      const shifted = async (text) => {
        await page.keyboard.down("Shift");
        await page.keyboard.type(text);
        await page.keyboard.up("Shift");
      };
      await shifted("R");
      await page.keyboard.type("apid");
      await shifted("_");
      await page.keyboard.type("typing");
      await shifted("@");
      await page.keyboard.type("1234");
      await page.keyboard.press("Backspace");
      return "sent two clicks and rapid typing through the Workspace canvas";
    }
    case "scroll-check": {
      const canvas = page.locator('canvas[aria-label="Live browser viewport"]');
      await canvas.waitFor({ state: "visible" });
      const box = await canvas.boundingBox();
      if (box === null) {
        throw new Error("The live browser canvas has no bounds.");
      }
      const count = Number(flags.events ?? 40);
      const delta = Number(flags.delta ?? 80);
      if (
        !Number.isInteger(count) ||
        count < 2 ||
        count > 240 ||
        !Number.isFinite(delta) ||
        delta <= 0 ||
        delta > 1000
      ) {
        throw new Error(
          "scroll-check needs 2–240 --events and positive --delta up to 1000."
        );
      }
      await page.mouse.move(box.x + box.width / 2, box.y + box.height / 2);
      await canvas.evaluate((element) => {
        const context = element.getContext("2d");
        if (context === null) {
          throw new Error("The live browser canvas has no 2D context.");
        }
        const original = context.drawImage;
        const measurements = {
          draws: [],
          drawOffsets: [],
          wheels: [],
          startedAt: performance.now(),
          initialScrollOffset:
            globalThis.__scrollFrames?.at(-1)?.offsetY ?? null,
        };
        const onWheel = () => measurements.wheels.push(performance.now());
        context.drawImage = function (...args) {
          const result = original.apply(this, args);
          measurements.draws.push(performance.now());
          const frame = globalThis.__scrollFrames?.at(-1);
          measurements.drawOffsets.push({
            at: performance.now(),
            latestReceivedOffsetY: frame?.offsetY ?? null,
            latestReceivedSeq: frame?.seq ?? null,
          });
          return result;
        };
        element.addEventListener("wheel", onWheel, { capture: true });
        element.__scrollCheck = {
          measurements,
          restore: () => {
            context.drawImage = original;
            element.removeEventListener("wheel", onWheel, { capture: true });
          },
        };
      });
      const gestures = [];
      try {
        for (const direction of [1, -1, 1]) {
          const startedAt = Date.now();
          for (let event = 0; event < count; event += 1) {
            // Await each native wheel. CDP resolves at the browser's real cadence;
            // overlapping promises would manufacture an automation backlog.
            await page.mouse.wheel(0, direction * delta);
          }
          gestures.push({
            direction,
            events: count,
            elapsedMs: Date.now() - startedAt,
          });
          await delay(500);
          if (
            typeof flags.path === "string" &&
            typeof flags.stage === "string"
          ) {
            const destination = resolveEvidencePath(
              `${flags.path}/${flags.stage}-gesture-${gestures.length}.png`
            );
            mkdirSync(path.dirname(destination), { recursive: true });
            await page.screenshot({ path: destination });
          }
        }
        await delay(1500);
        const measurements = await canvas.evaluate((element) => ({
          ...element.__scrollCheck.measurements,
          receivedFrames: (globalThis.__scrollFrames ?? []).filter(
            (frame) => frame.at >= element.__scrollCheck.measurements.startedAt
          ),
        }));
        const gaps = measurements.draws
          .slice(1)
          .map((time, index) => time - measurements.draws[index]);
        const cadence = measurements.wheels
          .slice(1)
          .map((time, index) => time - measurements.wheels[index]);
        const activeGaps = gestures.flatMap((_, index) => {
          const firstWheel = measurements.wheels[index * count];
          const lastWheel = measurements.wheels[(index + 1) * count - 1];
          const draws = measurements.draws.filter(
            (time) => time >= firstWheel && time <= lastWheel
          );
          return draws
            .slice(1)
            .map((time, drawIndex) => time - draws[drawIndex]);
        });
        const activeCadence = cadence.filter(
          (_, index) => (index + 1) % count !== 0
        );
        const nextDraw = measurements.wheels
          .map((time) => measurements.draws.find((draw) => draw >= time))
          .filter((time) => time !== undefined);
        const latency = measurements.wheels.flatMap((time) => {
          const draw = measurements.draws.find(
            (candidate) => candidate >= time
          );
          return draw === undefined ? [] : [draw - time];
        });
        const summary = (values) => {
          const sorted = [...values].sort((left, right) => left - right);
          return {
            samples: sorted.length,
            maxMs: sorted.at(-1) ?? null,
            p95Ms:
              sorted.length === 0
                ? null
                : sorted[Math.ceil(sorted.length * 0.95) - 1],
          };
        };
        const lastWheel = measurements.wheels.at(-1);
        const motionFrames = measurements.receivedFrames.filter(
          (frame, index, frames) =>
            frame.offsetY !==
            (index === 0
              ? measurements.initialScrollOffset
              : frames[index - 1].offsetY)
        );
        const receivedMotion = gestures.map((gesture, index) => {
          const start = measurements.wheels[index * count];
          const end = measurements.wheels[(index + 1) * count - 1] + 350;
          const frames = measurements.receivedFrames.filter(
            (frame) => frame.at >= start && frame.at <= end
          );
          const initial =
            measurements.receivedFrames
              .filter((frame) => frame.at < start)
              .at(-1)?.offsetY ?? measurements.initialScrollOffset;
          const final = frames.at(-1)?.offsetY ?? initial;
          return {
            direction: gesture.direction,
            initialOffsetY: initial,
            finalOffsetY: final,
            receivedFrameCount: frames.length,
            movedInRequestedDirection:
              initial === null || final === null
                ? null
                : (final - initial) * gesture.direction > 0,
          };
        });
        return JSON.stringify({
          kind: "native mouse.wheel through Workspace canvas",
          gestures,
          wheelCadence: summary(cadence),
          activeWheelCadence: summary(activeCadence),
          drawGaps: summary(gaps),
          activeDrawGaps: summary(activeGaps),
          wheelToNextDraw: summary(latency),
          wheelsWithoutLaterDraw: measurements.wheels.length - nextDraw.length,
          lastDrawAfterLastWheelMs:
            lastWheel === undefined || measurements.draws.length === 0
              ? null
              : measurements.draws.at(-1) - lastWheel,
          drawsAfterLastWheel500ms:
            lastWheel === undefined
              ? 0
              : measurements.draws.filter((time) => time > lastWheel + 500)
                  .length,
          receivedOffsetChanges: motionFrames.length,
          receivedMotion,
          lastReceivedOffsetChangeAfterLastWheelMs:
            lastWheel === undefined || motionFrames.length === 0
              ? null
              : motionFrames.at(-1).at - lastWheel,
          initialScrollOffsetY: measurements.initialScrollOffset,
          finalReceivedScrollOffsetY:
            measurements.receivedFrames.at(-1)?.offsetY ?? null,
          measurements,
        });
      } finally {
        await canvas.evaluate((element) => {
          element.__scrollCheck.restore();
          delete element.__scrollCheck;
        });
      }
    }
    case "click": {
      await locator(page, flags).click();
      return "";
    }
    case "fill": {
      if (typeof flags.value !== "string") {
        throw new Error("browser fill needs --value.");
      }
      await locator(page, flags).fill(flags.value);
      return "";
    }
    case "press": {
      if (typeof flags.key !== "string") {
        throw new Error("browser press needs --key.");
      }
      if (typeof flags.role === "string" && typeof flags.name === "string") {
        await locator(page, flags).press(flags.key);
      } else {
        await page.keyboard.press(flags.key);
      }
      return "";
    }
    case "wait": {
      const timeout =
        typeof flags["timeout-ms"] === "string"
          ? Number(flags["timeout-ms"])
          : 10_000;
      if (typeof flags.text === "string") {
        await page
          .getByText(flags.text, { exact: !partialMatch(flags) })
          .waitFor({ state: "visible", timeout });
        return "";
      }
      let target;
      if (typeof flags["has-text"] === "string") {
        if (typeof flags.role !== "string") {
          throw new Error("browser wait --has-text needs --role.");
        }
        target = page
          .getByRole(flags.role)
          .filter({ hasText: flags["has-text"] });
      } else {
        target = locator(page, flags);
      }
      await target.waitFor({ state: "visible", timeout });
      return "";
    }
    case "skills-layout-check": {
      if (typeof flags.path !== "string") {
        throw new Error("skills-layout-check needs --path.");
      }
      const scale = Number(flags["text-scale"] ?? 1);
      if (scale !== 1 && scale !== 2) {
        throw new Error("skills-layout-check text scale must be 1 or 2.");
      }
      await page.evaluate(async (value) => {
        document.documentElement.style.fontSize = `${16 * value}px`;
        await document.fonts.ready;
        await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
      }, scale);
      const drawer = page.getByRole("complementary", { name: "Skills", exact: true });
      await drawer.waitFor();
      await page.waitForFunction(() => !document.querySelector('aside[aria-label="Skills"]').getAnimations({ subtree: true }).some((animation) => animation.playState === "running"));
      const result = await drawer.evaluate((element) => {
        const bounds = element.getBoundingClientRect();
        const fontSize = Number.parseFloat(getComputedStyle(document.documentElement).fontSize);
        const catalog = element.querySelector('[aria-label="Catalog"]');
        const back = [...element.querySelectorAll("button")].find((button) => button.textContent.includes("Back to catalog"));
        const clipped = [];
        for (const heading of element.querySelectorAll("h2")) {
          const walker = document.createTreeWalker(heading, NodeFilter.SHOW_TEXT);
          while (walker.nextNode()) {
            const node = walker.currentNode;
            for (let offset = 0; offset < node.textContent.length; offset += 1) {
              const range = document.createRange();
              range.setStart(node, offset);
              range.setEnd(node, offset + 1);
              for (const rect of range.getClientRects()) {
                if (rect.left < bounds.left - 1 || rect.right > bounds.right + 1) {
                  clipped.push(node.textContent[offset]);
                }
              }
            }
          }
        }
        const controls = [...element.querySelectorAll("button,input")].map((control) => {
          const rect = control.getBoundingClientRect();
          return { name: control.getAttribute("aria-label") ?? control.textContent.trim(), left: rect.left, right: rect.right,
            fits: rect.left >= bounds.left - 1 && rect.right <= bounds.right + 1 && rect.left >= -1 && rect.right <= innerWidth + 1 && rect.width > 0 };
        });
        const narrow = bounds.width < 36 * fontSize;
        return { width: bounds.width, scrollWidth: element.scrollWidth, viewport: innerWidth, fontSize, narrow,
          catalog: catalog !== null, back: back !== undefined, clipped, controls,
          focus: { tag: document.activeElement.tagName, text: document.activeElement.textContent, label: document.activeElement.getAttribute("aria-label") },
          ok: element.scrollWidth <= Math.ceil(bounds.width) + 1 && clipped.length === 0 && controls.every((control) => control.fits) &&
            (!narrow || (catalog !== null) !== (back !== undefined)) };
      });
      const destination = resolveEvidencePath(flags.path);
      mkdirSync(destination, { recursive: true });
      writeFileSync(path.join(destination, "result.json"), `${JSON.stringify(result, null, 2)}\n`);
      writeFileSync(path.join(destination, "view.aria.txt"), `${await page.locator("body").ariaSnapshot()}\n`);
      await page.screenshot({ path: path.join(destination, "view.png") });
      if (!result.ok && flags["allow-overflow"] !== true) {
        throw new Error(`Skills layout failed. Read ${destination}/result.json.`);
      }
      return JSON.stringify({ ...result, destination });
    }
    case "procedure-check": {
      const { Effect } = await import(
        createRequire(import.meta.url).resolve("effect", {
          paths: [path.join(repoRoot, "packages/cli")],
        })
      );
      return Effect.runPromise(
        Effect.tryPromise({
          try: async () => {
            if (
              typeof flags["skill-file"] !== "string" ||
              typeof flags.path !== "string"
            ) {
              throw new Error(
                "browser procedure-check needs --skill-file and --path."
              );
            }
            const source = readFileSync(
              resolveInputFilePath(flags["skill-file"]),
              "utf8"
            );
            const expected = [
              ...source.matchAll(/^\d+\. (.+?)\s+Done when: (.+)$/gm),
            ].map(([, instruction, doneWhen]) => [
              instruction.trim(),
              `Done when: ${doneWhen}`,
            ]);
            if (expected.length === 0) {
              throw new Error(
                "procedure-check needs the one-line steps in the procedure-wrapping fixture."
              );
            }
            const scale = Number(flags["text-scale"] ?? 1);
            if (scale !== 1 && scale !== 2) {
              throw new Error("procedure-check text scale must be 1 or 2.");
            }
            await page.evaluate((value) => {
              document.documentElement.style.fontSize = `${16 * value}px`;
            }, scale);
            await page
              .getByRole("tabpanel", { name: "Procedure", exact: true })
              .waitFor();
            await page.evaluate(() => document.fonts.ready);
            const paragraphs = page
              .getByRole("tabpanel", { name: "Procedure", exact: true })
              .locator("li p");
            await paragraphs.first().scrollIntoViewIfNeeded();
            const result = await paragraphs.evaluateAll((elements) =>
              elements.map((element) => {
                const bounds = element.getBoundingClientRect();
                const walker = document.createTreeWalker(
                  element,
                  NodeFilter.SHOW_TEXT
                );
                const clipped = [];
                let characters = 0;
                while (walker.nextNode()) {
                  const node = walker.currentNode;
                  for (
                    let offset = 0;
                    offset < node.textContent.length;
                    offset += 1
                  ) {
                    const range = document.createRange();
                    range.setStart(node, offset);
                    range.setEnd(node, offset + 1);
                    for (const rect of range.getClientRects()) {
                      if (
                        rect.left < bounds.left - 1 ||
                        rect.right > bounds.right + 1 ||
                        rect.left < -1 ||
                        rect.right > innerWidth + 1 ||
                        rect.top < bounds.top - 1 ||
                        rect.bottom > bounds.bottom + 1
                      ) {
                        clipped.push({
                          character: node.textContent[offset],
                          left: rect.left,
                          right: rect.right,
                        });
                      }
                    }
                    characters += 1;
                  }
                }
                return {
                  characters,
                  clipped,
                  text: element.textContent,
                  width: bounds.width,
                };
              })
            );
            const destination = resolveEvidencePath(flags.path);
            mkdirSync(destination, { recursive: true });
            const actual = result.map((entry) => entry.text);
            const textMatches =
              JSON.stringify(actual) === JSON.stringify(expected.flat());
            const ok =
              textMatches &&
              result.every(
                (entry) => entry.clipped.length === 0 && entry.width > 0
              );
            writeFileSync(
              path.join(destination, "result.json"),
              `${JSON.stringify({ ok, scale, textMatches, result }, null, 2)}\n`
            );
            writeFileSync(
              path.join(destination, "procedure.aria.txt"),
              `${await page.locator("body").ariaSnapshot()}\n`
            );
            for (
              let index = 0;
              index < (await paragraphs.count());
              index += 1
            ) {
              await paragraphs.nth(index).scrollIntoViewIfNeeded();
              await page.screenshot({
                path: path.join(destination, `paragraph-${index + 1}.png`),
              });
            }
            if (!ok) {
              throw new Error(
                `Procedure text changed or clipped. Read ${destination}/result.json.`
              );
            }
            return JSON.stringify({
              ok,
              paragraphs: result.length,
              scale,
              destination,
            });
          },
          catch: (cause) =>
            cause instanceof Error ? cause : new Error(String(cause)),
        })
      );
    }
    case "snapshot": {
      if (flags.aria !== true && flags.aria !== "true") {
        throw new Error("browser snapshot currently supports --aria only.");
      }
      if (typeof flags.path !== "string") {
        throw new Error("browser snapshot needs --path.");
      }
      const snapshot = await page.locator("body").ariaSnapshot();
      const destination = resolveEvidencePath(flags.path);
      mkdirSync(path.dirname(destination), { recursive: true });
      writeFileSync(destination, `${snapshot}\n`);
      return destination;
    }
    case "screenshot": {
      if (typeof flags.path !== "string") {
        throw new Error("browser screenshot needs --path.");
      }
      const destination = resolveEvidencePath(flags.path);
      mkdirSync(path.dirname(destination), { recursive: true });
      await page.screenshot({ fullPage: true, path: destination });
      return destination;
    }
    case "set-input-files": {
      if (typeof flags.path !== "string") {
        throw new Error("browser set-input-files needs --path.");
      }
      const filePath = resolveInputFilePath(flags.path);
      if (!existsSync(filePath)) {
        throw new Error(
          `browser set-input-files file does not exist: ${filePath}`
        );
      }
      const target =
        typeof flags.label === "string"
          ? page.getByLabel(flags.label, { exact: !partialMatch(flags) })
          : locator(page, flags);
      await target.setInputFiles(filePath);
      return filePath;
    }
    case "download": {
      if (typeof flags.path !== "string") {
        throw new Error("browser download needs --path.");
      }
      const destination = resolveEvidencePath(flags.path);
      mkdirSync(path.dirname(destination), { recursive: true });
      const timeout =
        typeof flags["timeout-ms"] === "string"
          ? Number(flags["timeout-ms"])
          : 30_000;
      const downloadPromise = page.waitForEvent("download", { timeout });
      await locator(page, flags).click();
      const download = await downloadPromise;
      await download.saveAs(destination);
      return destination;
    }
    default: {
      throw new Error(`Unknown browser action: ${action}`);
    }
  }
};

const callDriver = async (instance, payload) => {
  const response = await fetch(instance.driverUrl, {
    body: JSON.stringify(payload),
    headers: { "content-type": "application/json" },
    method: "POST",
  });
  const body = await response.text();
  let parsed;
  try {
    parsed = JSON.parse(body);
  } catch {
    fail(`Driver returned non-JSON (${response.status}): ${body}`);
  }
  if (!response.ok || parsed.ok !== true) {
    fail(parsed.error ?? `Driver error (${response.status})`);
  }
  return parsed.output ?? "";
};

const ensureBuiltCli = () => {
  const cli = path.join(repoRoot, "packages/cli/dist/index.js");
  const web = path.join(repoRoot, "packages/cli/dist/web/index.html");
  if (!existsSync(cli) || !existsSync(web)) {
    fail(
      "The CLI production build is missing. From the repo root run: nub exec turbo run build --filter=@contingencyhq/cli"
    );
  }
  return cli;
};

const waitForHttp = async (url, timeoutMs) => {
  const deadline = Date.now() + timeoutMs;
  let lastError = "not yet requested";
  while (Date.now() < deadline) {
    try {
      const response = await fetch(url);
      if (response.ok) {
        return;
      }
      lastError = `HTTP ${response.status}`;
    } catch (error) {
      lastError = error instanceof Error ? error.message : String(error);
    }
    await delay(100);
  }
  throw new Error(`Timed out waiting for ${url}: ${lastError}`);
};

const waitForFile = async (file, timeoutMs) => {
  const deadline = Date.now() + timeoutMs;
  while (Date.now() < deadline) {
    if (existsSync(file)) {
      const contents = readFileSync(file, "utf8").trim();
      if (contents.length > 0) {
        return contents;
      }
    }
    await delay(50);
  }
  throw new Error(`Timed out waiting for ${file}`);
};

const launchCli = async ({ directory, port, stateDir }) => {
  const cli = ensureBuiltCli();
  const args = [cli, "web", "--no-browser"];
  mkdirSync(directory, { recursive: true });
  const logPath = path.join(directory, "server.log");
  const logFd = openSync(logPath, "a");
  const child = spawn(process.execPath, args, {
    cwd: repoRoot,
    detached: true,
    env: {
      ...process.env,
      CONTINGENCY_CATALOG_ROOT: path.join(stateDir, "catalog"),
      // The Skills drawer also lists a user-global root; a drive must not
      // read the developer's real ~/.contingency.
      CONTINGENCY_GLOBAL_CATALOG_ROOT: path.join(stateDir, "global-catalog"),
      CONTINGENCY_WEB_HOST: "127.0.0.1",
      CONTINGENCY_WEB_PORT: String(port),
      NODE_ENV: "production",
    },
    stdio: ["ignore", logFd, logFd],
  });
  closeSync(logFd);
  child.unref();
  if (child.pid === undefined) {
    fail("Failed to spawn the Contingency CLI.");
  }
  try {
    await waitForHttp(`http://127.0.0.1:${port}/`, 30_000);
  } catch (error) {
    child.kill("SIGTERM");
    throw error;
  }
  return child;
};

const selfPath = fileURLToPath(import.meta.url);

const spawnDetached = (args, extraEnv = {}) => {
  const child = spawn(process.execPath, [selfPath, ...args], {
    cwd: repoRoot,
    detached: true,
    env: { ...process.env, ...extraEnv },
    stdio: "ignore",
  });
  child.unref();
  return child;
};

const launchDriver = async (url, directory) => {
  const userDataDir = path.join(directory, "browser-profile");
  mkdirSync(userDataDir, { recursive: true });
  const readyFile = path.join(userDataDir, "driver-url.txt");
  rmSync(readyFile, { force: true });
  const child = spawnDetached(["driver-serve", url, userDataDir]);
  if (child.pid === undefined) {
    fail("Failed to spawn the driver browser.");
  }
  const driverUrl = await waitForFile(readyFile, 60_000);
  return { driverPid: child.pid, driverUrl };
};

const cmdDriverServe = async (url, userDataDir) => {
  const { chromium } = loadPlaywright();
  mkdirSync(userDataDir, { recursive: true });
  const browser = await chromium.launch({ headless: true });
  const context = await browser.newContext({
    viewport: { height: 900, width: 1440 },
  });
  await context.addInitScript(() => {
    const NativeWebSocket = globalThis.WebSocket;
    globalThis.__scrollFrames = [];
    globalThis.WebSocket = class extends NativeWebSocket {
      constructor(url, protocols) {
        super(url, protocols);
        this.addEventListener("message", (event) => {
          if (typeof event.data !== "string") {
            return;
          }
          let message;
          try {
            message = JSON.parse(event.data);
          } catch {
            return;
          }
          const visit = (value) => {
            if (value === null || typeof value !== "object") {
              return;
            }
            if (
              value.type === "frame" &&
              typeof value.metadata?.scrollOffsetY === "number"
            ) {
              globalThis.__scrollFrames.push({
                at: performance.now(),
                offsetY: value.metadata.scrollOffsetY,
                seq: value.seq,
              });
              if (globalThis.__scrollFrames.length > 10000) {
                globalThis.__scrollFrames.shift();
              }
              return;
            }
            for (const child of Object.values(value)) {
              visit(child);
            }
          };
          visit(message);
        });
      }
    };
  });
  const page = await context.newPage();
  await page.goto(url, { waitUntil: "load" });
  const server = createHttpServer((request, response) => {
    if (request.method === "GET") {
      response.writeHead(200, { "content-type": "application/json" });
      response.end(`${JSON.stringify({ ok: true, url: page.url() })}\n`);
      return;
    }
    if (request.method !== "POST") {
      response.writeHead(405);
      response.end();
      return;
    }
    const chunks = [];
    request.on("data", (chunk) => {
      chunks.push(chunk);
    });
    request.on("end", () => {
      void (async () => {
        try {
          const payload = JSON.parse(Buffer.concat(chunks).toString("utf8"));
          const output = await runPageAction(
            page,
            url,
            payload.action,
            payload.flags ?? {}
          );
          response.writeHead(200, { "content-type": "application/json" });
          response.end(`${JSON.stringify({ ok: true, output })}\n`);
        } catch (error) {
          response.writeHead(500, { "content-type": "application/json" });
          response.end(
            `${JSON.stringify({
              error: error instanceof Error ? error.message : String(error),
              ok: false,
            })}\n`
          );
        }
      })();
    });
  });
  const port = await new Promise((resolve, reject) => {
    server.once("error", reject);
    server.listen(0, "127.0.0.1", () => {
      const address = server.address();
      if (address === null || typeof address === "string") {
        reject(new Error("Could not bind the driver command server."));
        return;
      }
      resolve(address.port);
    });
  });
  writeFileSync(
    path.join(userDataDir, "driver-url.txt"),
    `http://127.0.0.1:${port}/\n`
  );
};

const cmdLaunch = async () => {
  const stamp = `${Date.now()}-${process.pid}`;
  const directory =
    process.env.CONTINGENCY_VERIFY_DIR?.trim() ??
    path.join(tmpdir(), `contingency-verify-${stamp}`);
  if (existsSync(instancePath(directory))) {
    const existing = JSON.parse(readFileSync(instancePath(directory), "utf8"));
    if (pidAlive(existing.pid)) {
      fail(
        `Refusing to launch: ${directory} already has a live instance (pid ${existing.pid}). cleanup that run first.`
      );
    }
  }
  mkdirSync(directory, { recursive: true });
  const stateDir = path.join(directory, "state");
  mkdirSync(stateDir, { recursive: true });
  const port = await pickPort();
  const owner = await listenPid(port);
  if (owner !== undefined) {
    fail(
      `Port ${port} is owned by pid ${owner}. Do not drive that instance; pick another port.`
    );
  }
  const child = await launchCli({ directory, port, stateDir });
  const url = `http://127.0.0.1:${port}/`;
  let driver;
  try {
    driver = await launchDriver(url, directory);
  } catch (error) {
    child.kill("SIGTERM");
    fail(
      `Started Contingency but could not open a driver browser: ${error instanceof Error ? error.message : String(error)}\nInstall Chromium with: nub exec --cwd packages/cli playwright-core install chromium`
    );
  }
  writeInstance(directory, {
    driverPid: driver.driverPid,
    driverUrl: driver.driverUrl,
    pid: child.pid,
    port,
    repoRoot,
    stateDir,
    url,
  });
  process.stdout.write(
    `CONTINGENCY_VERIFY_DIR=${directory}\nurl=${url}\npid=${child.pid}\ndriverPid=${driver.driverPid}\nport=${port}\nstate=${stateDir}\n`
  );
};

const fetchText = async (url) => {
  const response = await fetch(url);
  const body = await response.text();
  return { body, status: response.status };
};

const cmdDoctor = async () => {
  const instance = readInstance();
  const problems = [];
  if (!pidAlive(instance.pid)) {
    problems.push(`server pid ${instance.pid} is not running`);
  }
  const owner = await listenPid(instance.port);
  if (owner !== instance.pid) {
    problems.push(
      owner === undefined
        ? `nothing is listening on ${instance.port}`
        : `port ${instance.port} is owned by pid ${owner}, not ${instance.pid}`
    );
  }
  let page;
  try {
    page = await fetchText(instance.url);
    if (page.status !== 200) {
      problems.push(`GET ${instance.url} returned ${page.status}`);
    }
    if (!page.body.includes("Contingency")) {
      problems.push(`GET ${instance.url} did not include the Contingency mark`);
    }
  } catch (error) {
    problems.push(
      `GET ${instance.url} failed: ${error instanceof Error ? error.message : String(error)}`
    );
  }
  if (typeof instance.driverPid === "number" && !pidAlive(instance.driverPid)) {
    problems.push(`driver pid ${instance.driverPid} is not running`);
  }
  try {
    const driver = await fetchText(instance.driverUrl);
    if (driver.status !== 200 || !driver.body.includes('"ok":true')) {
      problems.push(`driver ${instance.driverUrl} is not healthy`);
    }
  } catch (error) {
    problems.push(
      `driver ${instance.driverUrl} is not reachable: ${error instanceof Error ? error.message : String(error)}`
    );
  }
  if (problems.length > 0) {
    fail(`doctor failed:\n- ${problems.join("\n- ")}`);
  }
  process.stdout.write(
    `${JSON.stringify(
      {
        ok: true,
        pid: instance.pid,
        port: instance.port,
        stateDir: instance.stateDir,
        url: instance.url,
      },
      null,
      2
    )}\n`
  );
};

const cmdCleanup = async () => {
  const directory = verifyDir();
  const file = instancePath(directory);
  if (!existsSync(file)) {
    process.stdout.write(`No instance at ${file}.\n`);
    return;
  }
  const instance = JSON.parse(readFileSync(file, "utf8"));
  const stopPid = async (pid) => {
    if (!pidAlive(pid)) {
      return;
    }
    process.kill(pid, "SIGTERM");
    const deadline = Date.now() + 10_000;
    while (pidAlive(pid) && Date.now() < deadline) {
      await delay(100);
    }
    if (pidAlive(pid)) {
      process.kill(pid, "SIGKILL");
    }
  };
  if (typeof instance.driverPid === "number") {
    await stopPid(instance.driverPid);
  }
  if (typeof instance.pid === "number") {
    await stopPid(instance.pid);
  }
  if (typeof instance.fixturePid === "number") {
    await stopPid(instance.fixturePid);
  }
  if (typeof instance.mcpPid === "number") {
    await stopPid(instance.mcpPid);
  }
  rmSync(path.join(directory, "browser-profile"), {
    force: true,
    recursive: true,
  });
  rmSync(instance.stateDir, { force: true, recursive: true });
  rmSync(file, { force: true });
  process.stdout.write(
    `cleaned ${directory} (evidence under ${defaultArtifacts} is untouched)\n`
  );
};

/** What `browser input-check` types into its fixture field. */
const INPUT_CHECK_TEXT = "Rapid_typing@123";

/** Call one MCP tool on the running broker and answer its decoded result. */
const brokerCall = async (instance, tool, params) => {
  const response = await fetch(`${instance.brokerUrl}call`, {
    body: JSON.stringify({ params, tool }),
    headers: { "content-type": "application/json" },
    method: "POST",
  });
  const result = await response.json();
  if (!response.ok || result.isError === true) {
    fail(`${tool} failed: ${JSON.stringify(result)}`);
  }
  const text = result.content?.find((entry) => entry.type === "text")?.text;
  return text === undefined ? result.structuredContent : JSON.parse(text);
};

const cmdBrowser = async (action, flags) => {
  const instance = readInstance();
  if (action === "scroll-check") {
    if (
      typeof flags["session-id"] !== "string" ||
      typeof instance.brokerUrl !== "string"
    ) {
      fail(
        "browser scroll-check needs --session-id and a running verification MCP server."
      );
    }
    const sessionId = flags["session-id"];
    const session = await brokerCall(instance, "agent_session_get", {
      sessionId,
    });
    if (
      session.activity !== "teaching" ||
      session.controller !== "user" ||
      session.captureState?._tag !== "setup"
    ) {
      fail(
        "scroll-check starts from a user-held Teaching setup, before recording."
      );
    }
    const evidence =
      typeof flags.path === "string" ? flags.path : "scroll-check";
    const capture = async (stage) => {
      const result = JSON.parse(
        await callDriver(instance, {
          action,
          flags: { ...flags, path: evidence, stage },
        })
      );
      await callDriver(instance, {
        action: "screenshot",
        flags: { path: `${evidence}/${stage}.png` },
      });
      await callDriver(instance, {
        action: "snapshot",
        flags: { aria: true, path: `${evidence}/${stage}.aria.txt` },
      });
      return result;
    };
    const before = await capture("before-recording");
    const result = { sessionId, url: session.currentUrl, before };
    if (flags.record === true || flags.record === "true") {
      await callDriver(instance, {
        action: "click",
        flags: { role: "button", name: "Start recording" },
      });
      await callDriver(instance, {
        action: "wait",
        flags: { role: "button", name: "Stop recording" },
      });
      result.during = await capture("during-recording");
      await callDriver(instance, {
        action: "click",
        flags: { role: "button", name: "Stop recording" },
      });
      const deadline = Date.now() + 60_000;
      let stopped;
      while (Date.now() < deadline) {
        stopped = await brokerCall(instance, "agent_session_get", {
          sessionId,
        });
        if (stopped.captureState?._tag === "ready") {
          break;
        }
        await delay(250);
      }
      if (stopped?.captureState?._tag !== "ready") {
        fail(
          `Scroll recording never became ready: ${JSON.stringify(stopped?.captureState)}`
        );
      }
      const { recordingId } = stopped;
      const claimOperationId = `verify-scroll-check-${recordingId}`;
      await brokerCall(instance, "agent_teaching_recording_claim", {
        action: "take",
        operationId: claimOperationId,
        recordingId,
      });
      const entries = [];
      let cursor;
      do {
        const timeline = await brokerCall(
          instance,
          "agent_teaching_timeline_get",
          {
            recordingId,
            claimOperationId,
            ...(cursor === undefined ? {} : { cursor }),
          }
        );
        entries.push(...(timeline.entries ?? []));
        cursor = timeline.nextCursor ?? undefined;
      } while (cursor !== undefined);
      const actions = entries.filter((entry) => entry._tag === "action");
      const scrolls = actions.filter(
        (entry) =>
          entry.kind === "input" &&
          entry.description === "The user scrolled the Page"
      );
      const keyframes = entries.filter((entry) => entry._tag === "keyframe");
      const wheelCount = result.during.measurements.wheels.length;
      result.recording = { recordingId, actions, keyframes, wheelCount };
      const missingScrollEvidence = scrolls.some(
        (entry) =>
          entry.before?.nodeCount === undefined ||
          entry.after?.nodeCount === undefined ||
          !keyframes.some((keyframe) => keyframe.actionId === entry.id)
      );
      if (
        scrolls.length === 0 ||
        scrolls.length >= wheelCount ||
        keyframes.length === 0 ||
        missingScrollEvidence ||
        actions.some((entry) => /\be\d+\b/u.test(entry.description))
      ) {
        const destination = resolveEvidencePath(`${evidence}/result.json`);
        mkdirSync(path.dirname(destination), { recursive: true });
        writeFileSync(destination, `${JSON.stringify(result, null, 2)}\n`);
        fail(
          `Scroll capture did not retain semantic gestures and keyframes: ${scrolls.length} scroll actions for ${wheelCount} wheels; ${keyframes.length} keyframes. Evidence ${destination}`
        );
      }
      result.recording.keyframe = await brokerCall(
        instance,
        "agent_teaching_keyframe_get",
        { recordingId, claimOperationId, keyframeId: keyframes[0].id }
      );
    }
    const destination = resolveEvidencePath(`${evidence}/result.json`);
    mkdirSync(path.dirname(destination), { recursive: true });
    writeFileSync(destination, `${JSON.stringify(result, null, 2)}\n`);
    const summarize = (stage) => {
      const { measurements: ignoredMeasurements, ...summary } = stage;
      return summary;
    };
    process.stdout.write(
      `${JSON.stringify({
        sessionId,
        url: result.url,
        before: summarize(result.before),
        ...(result.during === undefined
          ? {}
          : { during: summarize(result.during) }),
        ...(result.recording === undefined
          ? {}
          : {
              recording: {
                recordingId: result.recording.recordingId,
                actions: result.recording.actions.length,
                keyframes: result.recording.keyframes.length,
                wheelCount: result.recording.wheelCount,
                keyframe: result.recording.keyframe,
              },
            }),
      })}\nEvidence: ${destination}\n`
    );
    return;
  }
  if (
    action === "input-check" &&
    (typeof flags["session-id"] !== "string" ||
      typeof instance.brokerUrl !== "string")
  ) {
    fail(
      "browser input-check needs --session-id and a running verification MCP server."
    );
  }
  const output = await callDriver(instance, { action, flags });
  if (action === "input-check") {
    const sessionId = flags["session-id"];
    const deadline = Date.now() + 5_000;
    let observed = {};
    let landed = false;
    while (Date.now() < deadline) {
      const nodes = (
        await brokerCall(instance, "agent_browser_snapshot", { sessionId })
      )?.nodes;
      const count = nodes?.find((node) => node.role === "output");
      const typed = nodes?.find(
        (node) => node.role === "textbox" && node.name === "Typing target"
      );
      observed = { count: count?.name, value: typed?.value };
      if (count?.name === "Clicks: 2" && typed?.value === INPUT_CHECK_TEXT) {
        landed = true;
        break;
      }
      await delay(50);
    }
    if (!landed) {
      fail(`Workspace input lost a click or key: ${JSON.stringify(observed)}`);
    }
    // The Page holding the right text proves the keys arrived. What the
    // learning agent reads is the Teaching Timeline, so stop and read it back:
    // a field typed once is one fill, named by its role and accessible name.
    await callDriver(instance, {
      action: "click",
      flags: { name: "Stop recording", role: "button" },
    });
    const stopDeadline = Date.now() + 30_000;
    let session;
    while (Date.now() < stopDeadline) {
      session = await brokerCall(instance, "agent_session_get", { sessionId });
      if (session?.captureState?._tag === "ready") {
        break;
      }
      await delay(250);
    }
    if (session?.captureState?._tag !== "ready") {
      fail(
        `Input check recording never became ready: ${JSON.stringify(session?.captureState)}`
      );
    }
    const { recordingId } = session;
    const claimOperationId = `verify-input-check-${recordingId}`;
    await brokerCall(instance, "agent_teaching_recording_claim", {
      action: "take",
      operationId: claimOperationId,
      recordingId,
    });
    const actions = [];
    let cursor;
    do {
      const page = await brokerCall(instance, "agent_teaching_timeline_get", {
        claimOperationId,
        recordingId,
        ...(cursor === undefined ? {} : { cursor }),
      });
      actions.push(
        ...(page?.entries ?? []).filter((entry) => entry._tag === "action")
      );
      cursor = page?.nextCursor ?? undefined;
    } while (cursor !== undefined);
    const fills = actions.filter((action) => action.kind === "fill");
    const expected = `Fill textbox "Typing target" with "${INPUT_CHECK_TEXT}"`;
    const byReference = actions.filter((action) =>
      /\be\d+\b/u.test(action.description)
    );
    if (
      fills.length !== 1 ||
      fills[0].description !== expected ||
      byReference.length > 0
    ) {
      fail(
        `Teaching Timeline did not record one named fill. Expected ${JSON.stringify(expected)}; got ${JSON.stringify(
          actions.map((action) => action.description)
        )}`
      );
    }
    process.stdout.write(`${output}\nteaching timeline: ${expected}\n`);
    return;
  }
  if (output.length > 0) {
    process.stdout.write(`${output}\n`);
  }
};

const cmdCli = async (rest) => {
  if (rest.length === 0) {
    fail("cli needs arguments after --, for example: cli -- mcp --help");
  }
  const instance = existsSync(instancePath()) ? readInstance() : undefined;
  const cli = ensureBuiltCli();
  const stateDir = instance?.stateDir ?? path.join(verifyDir(), "state");
  mkdirSync(stateDir, { recursive: true });
  const child = spawn(process.execPath, [cli, ...rest], {
    cwd: repoRoot,
    env: {
      ...process.env,
      CONTINGENCY_CATALOG_ROOT: path.join(stateDir, "catalog"),
      // The Skills drawer also lists a user-global root; a drive must not
      // read the developer's real ~/.contingency.
      CONTINGENCY_GLOBAL_CATALOG_ROOT: path.join(stateDir, "global-catalog"),
      HOME: instance === undefined ? homedir() : path.join(verifyDir(), "home"),
      NODE_ENV: "production",
    },
    stdio: "inherit",
  });
  const code = await new Promise((resolve) => {
    child.once("exit", (exitCode, signal) => {
      resolve(exitCode ?? (signal === null ? 1 : 1));
    });
  });
  process.exit(code ?? 1);
};

const cmdFixtureServe = async () => {
  const directory = verifyDir();
  const pages = loadEcommercePages();
  const server = createHttpServer((request, response) => {
    const url = request.url ?? "/";
    const { pathname, searchParams } = new URL(url, "http://127.0.0.1");
    if (pathname.startsWith("/browser-check-scalar/")) {
      const mismatch = searchParams.has("mismatch");
      const values = mismatch
        ? { string: "pending", boolean: false, number: 43, null: "not null" }
        : { string: "ready", boolean: true, number: 42, null: null };
      const kind = pathname.slice("/browser-check-scalar/".length);
      if (!Object.hasOwn(values, kind)) {
        response.writeHead(404);
        response.end();
        return;
      }
      const body = JSON.stringify(values[kind]);
      response.writeHead(200, { "content-type": "application/json", "content-length": Buffer.byteLength(body) });
      response.end(body);
      return;
    }
    if (pathname === "/browser-check-response") {
      const phase = searchParams.get("phase") === "ready" ? "ready" : "pending";
      const body = JSON.stringify({ order: { status: phase, items: [{ sku: "ANVIL-001", count: 2 }, { sku: "ROPE-001", count: 1 }] }, token: "fixture-private-token" });
      const headers = { "content-type": "application/json", "content-length": Buffer.byteLength(body) };
      if (searchParams.has("create")) headers["set-cookie"] = "checkout_ready=fixture-private-cookie; Path=/; HttpOnly; SameSite=Lax";
      response.writeHead(200, headers);
      response.end(body);
      return;
    }
    if (pathname === "/cart-added" || pathname === "/cart-viewed") {
      response.writeHead(204);
      response.end();
      return;
    }
    const pagePath = pathname === "/" ? "/shop.html" : pathname;
    const body = pages.get(pagePath);
    if (body === undefined) {
      response.writeHead(404, { "content-type": "text/plain; charset=utf-8" });
      response.end("Not found\n");
      return;
    }
    response.writeHead(200, { "content-type": "text/html; charset=utf-8" });
    response.end(body);
  });
  const port = await new Promise((resolve, reject) => {
    server.once("error", reject);
    server.listen(0, "127.0.0.1", () => {
      const address = server.address();
      if (address === null || typeof address === "string") {
        reject(new Error("Could not bind the fixture server."));
        return;
      }
      resolve(address.port);
    });
  });
  const shopUrl = `http://127.0.0.1:${port}/shop.html`;
  const readyFile = path.join(directory, "fixture-url.txt");
  writeFileSync(readyFile, `${shopUrl}\n`);
  await new Promise(() => {
    // Stay alive until cleanup.
  });
};

const cmdFixtureStart = async () => {
  const directory = verifyDir();
  mkdirSync(directory, { recursive: true });
  const instance = existsSync(instancePath())
    ? JSON.parse(readFileSync(instancePath(), "utf8"))
    : {};
  if (
    typeof instance.fixturePid === "number" &&
    pidAlive(instance.fixturePid)
  ) {
    fail(`Fixture already running as pid ${instance.fixturePid}.`);
  }
  const readyFile = path.join(directory, "fixture-url.txt");
  rmSync(readyFile, { force: true });
  const child = spawnDetached(["fixture-serve"], {
    CONTINGENCY_VERIFY_DIR: directory,
  });
  const shopUrl = await waitForFile(readyFile, 10_000);
  writeInstance(directory, {
    ...instance,
    ecommerceUrl: shopUrl,
    fixturePid: child.pid,
    fixtureUrl: shopUrl,
  });
  process.stdout.write(`ecommerce=${shopUrl}\nfixture=${shopUrl}\n`);
};

const cmdMcpStart = async () => {
  const directory = verifyDir();
  const instance = readInstance();
  if (typeof instance.mcpPid === "number" && pidAlive(instance.mcpPid)) {
    fail(`MCP already running as pid ${instance.mcpPid}.`);
  }
  const port = await pickPort();
  const owner = await listenPid(port);
  if (owner !== undefined) {
    fail(`Port ${port} is owned by pid ${owner}. Pick another port.`);
  }
  const cli = ensureBuiltCli();
  const brokerPort = await pickPort();
  const logPath = path.join(directory, "mcp.log");
  const logFd = openSync(logPath, "a");
  // The MCP server is spawned by a broker that holds one stdio conversation
  // open, so `mcp call` can start Agent Sessions in the same process that
  // serves Agent View. Sessions live in that process and nowhere else.
  const child = spawn(
    process.execPath,
    [
      path.join(here, "mcp-broker.mjs"),
      "--cli",
      cli,
      "--port",
      String(brokerPort),
    ],
    {
      cwd: repoRoot,
      detached: true,
      env: {
        ...process.env,
        // The Catalog Root defaults to the working directory's
        // `.contingency`; a verification drive must not write Flow Skills into
        // the repository, so it gets its own root under the isolated state.
        CONTINGENCY_CATALOG_ROOT: path.join(instance.stateDir, "catalog"),
        CONTINGENCY_GLOBAL_CATALOG_ROOT: path.join(
          instance.stateDir,
          "global-catalog"
        ),
        CONTINGENCY_MCP_HOST: "127.0.0.1",
        CONTINGENCY_MCP_PORT: String(port),
        NODE_ENV: "production",
      },
      stdio: ["ignore", logFd, logFd],
    }
  );
  closeSync(logFd);
  child.unref();
  if (child.pid === undefined) {
    fail("Failed to spawn the Contingency MCP server.");
  }
  const mcpUrl = `http://127.0.0.1:${port}/`;
  const brokerUrl = `http://127.0.0.1:${brokerPort}/`;
  try {
    await waitForHttp(`${brokerUrl}health`, 30_000);
    await waitForHttp(mcpUrl, 30_000);
    const ready = await fetchText(mcpUrl);
    if (!ready.body.includes("Contingency")) {
      throw new Error(`GET ${mcpUrl} did not include the Contingency mark`);
    }
  } catch (error) {
    child.kill("SIGTERM");
    fail(
      `Started MCP but the Agent View endpoint did not become ready: ${error instanceof Error ? error.message : String(error)}`
    );
  }
  writeInstance(directory, {
    ...instance,
    brokerUrl,
    mcpPid: child.pid,
    mcpPort: port,
    mcpUrl,
  });
  process.stdout.write(
    `mcpUrl=${mcpUrl}\nmcpPort=${port}\nmcpPid=${child.pid}\nbrokerUrl=${brokerUrl}\n`
  );
};

/**
 * Call one MCP tool on the running verification server. This is how a drive
 * creates the Agent Sessions Agent View shows: they exist only inside the MCP
 * process that owns them.
 */
const cmdMcpCall = async (flags) => {
  const instance = readInstance();
  if (typeof instance.brokerUrl !== "string") {
    fail("No MCP instance is recorded. Run mcp start first.");
  }
  const tool = typeof flags.tool === "string" ? flags.tool : undefined;
  if (tool === undefined) {
    fail("mcp call needs --tool <name>.");
  }
  let params = {};
  if (typeof flags.params === "string") {
    try {
      params = JSON.parse(flags.params);
    } catch (error) {
      fail(
        `--params is not JSON: ${error instanceof Error ? error.message : String(error)}`
      );
    }
  }
  const response = await fetch(`${instance.brokerUrl}call`, {
    body: JSON.stringify({ params, tool }),
    headers: { "content-type": "application/json" },
    method: "POST",
  });
  const body = await response.text();
  if (!response.ok) {
    fail(`${tool} failed (${response.status}): ${body}`);
  }
  const result = JSON.parse(body);
  // A tool refusal is an answer, not a transport failure: it is printed with a
  // non-zero exit so a drive can assert on the reason it names.
  const text = (result.content ?? [])
    .filter((entry) => entry.type === "text")
    .map((entry) => entry.text)
    .join("\n");
  process.stdout.write(`${text.length > 0 ? text : body}\n`);
  if (result.isError === true) {
    process.exit(2);
  }
};

/**
 * List or read one MCP resource on the running verification server. This is
 * how a drive reads the authoring skills Contingency serves, in the same MCP
 * conversation that later saves the Flow Skill.
 */
const cmdMcpResource = async (flags) => {
  const instance = readInstance();
  if (typeof instance.brokerUrl !== "string") {
    fail("No MCP instance is recorded. Run mcp start first.");
  }
  const uri = typeof flags.uri === "string" ? flags.uri : undefined;
  const response = await fetch(`${instance.brokerUrl}resource`, {
    body: JSON.stringify(uri === undefined ? {} : { uri }),
    headers: { "content-type": "application/json" },
    method: "POST",
  });
  const body = await response.text();
  if (!response.ok) {
    fail(`${uri ?? "resources/list"} failed (${response.status}): ${body}`);
  }
  const result = JSON.parse(body);
  const text = (result.contents ?? [])
    .filter((entry) => typeof entry.text === "string")
    .map((entry) => entry.text)
    .join("\n");
  process.stdout.write(`${text.length > 0 ? text : body}\n`);
};

const cmdMcpTools = async (flags) => {
  const instance = readInstance();
  if (typeof instance.brokerUrl !== "string") {
    fail("No MCP instance is recorded. Run mcp start first.");
  }
  const response = await fetch(`${instance.brokerUrl}tools`);
  const body = await response.text();
  if (!response.ok) {
    fail(`tools/list failed (${response.status}): ${body}`);
  }
  const result = JSON.parse(body);
  const name = typeof flags.name === "string" ? flags.name : undefined;
  if (name === undefined) {
    process.stdout.write(`${body}\n`);
    return;
  }
  const tool = result.tools?.find((entry) => entry.name === name);
  if (tool === undefined) {
    fail(`Tool ${name} is absent from tools/list.`);
  }
  process.stdout.write(`${JSON.stringify(tool)}\n`);
};

const cmdMcpChannels = async () => {
  const { brokerUrl } = readInstance();
  if (typeof brokerUrl !== "string") { fail("No MCP instance is recorded. Run mcp start first."); }
  const response = await fetch(`${brokerUrl}channels`);
  const body = await response.text();
  if (!response.ok) { fail(`Channel capture failed (${response.status}): ${body}`); }
  process.stdout.write(`${body}\n`);
};

const cmdMcpStop = async () => {
  const instance = readInstance();
  if (typeof instance.mcpPid !== "number" || !pidAlive(instance.mcpPid)) {
    fail("No live MCP instance is recorded for this verify directory.");
  }
  process.kill(instance.mcpPid, "SIGTERM");
  const deadline = Date.now() + 10_000;
  while (pidAlive(instance.mcpPid) && Date.now() < deadline) {
    await delay(100);
  }
  if (pidAlive(instance.mcpPid)) {
    process.kill(instance.mcpPid, "SIGKILL");
  }
  const next = { ...instance };
  delete next.brokerUrl;
  delete next.mcpPid;
  delete next.mcpPort;
  delete next.mcpUrl;
  writeInstance(verifyDir(), next);
  process.stdout.write("mcp stopped\n");
};

const cmdFixtureStop = async () => {
  const instance = readInstance();
  if (
    typeof instance.fixturePid === "number" &&
    pidAlive(instance.fixturePid)
  ) {
    process.kill(instance.fixturePid, "SIGTERM");
  }
  const next = { ...instance };
  delete next.fixturePid;
  delete next.fixturePort;
  delete next.fixtureUrl;
  writeInstance(verifyDir(), next);
};

const main = async () => {
  const argv = process.argv.slice(2);
  if (argv.length === 0 || argv[0] === "-h" || argv[0] === "--help") {
    usage();
    return;
  }
  const command = argv[0];
  if (command === "launch") {
    await cmdLaunch();
    return;
  }
  if (command === "doctor") {
    await cmdDoctor();
    return;
  }
  if (command === "cleanup") {
    await cmdCleanup();
    return;
  }
  if (command === "browser") {
    const action = argv[1];
    if (action === undefined) {
      fail("browser needs an action.");
    }
    await cmdBrowser(action, parseArgs(argv.slice(2)).flags);
    return;
  }
  if (command === "cli") {
    const dash = argv.indexOf("--");
    const rest = dash === -1 ? argv.slice(1) : argv.slice(dash + 1);
    await cmdCli(rest);
    return;
  }
  if (command === "driver-serve") {
    const url = argv[1];
    const userDataDir = argv[2];
    if (url === undefined || userDataDir === undefined) {
      fail("driver-serve needs a url and user data directory.");
    }
    await cmdDriverServe(url, userDataDir);
    return;
  }
  if (command === "fixture-serve") {
    await cmdFixtureServe();
    return;
  }
  if (command === "ecommerce") {
    const action = argv[1];
    if (action === "start") {
      await cmdFixtureStart();
      return;
    }
    if (action === "stop") {
      await cmdFixtureStop();
      return;
    }
    fail("ecommerce needs start or stop.");
  }
  if (command === "fixture") {
    const action = argv[1];
    if (action === "start") {
      await cmdFixtureStart();
      return;
    }
    if (action === "stop") {
      await cmdFixtureStop();
      return;
    }
    fail("fixture needs start or stop.");
  }
  if (command === "mcp") {
    const action = argv[1];
    if (action === "start") {
      await cmdMcpStart();
      return;
    }
    if (action === "call") {
      await cmdMcpCall(parseArgs(argv.slice(2)).flags);
      return;
    }
    if (action === "channels") {
      await cmdMcpChannels();
      return;
    }
    if (action === "tools") {
      await cmdMcpTools(parseArgs(argv.slice(2)).flags);
      return;
    }
    if (action === "resources") {
      await cmdMcpResource({});
      return;
    }
    if (action === "resource") {
      await cmdMcpResource(parseArgs(argv.slice(2)).flags);
      return;
    }
    if (action === "stop") {
      await cmdMcpStop();
      return;
    }
    fail("mcp needs start, call, tools, resources, resource, or stop.");
  }
  fail(`Unknown command: ${command}`);
};

main().catch((error) => {
  fail(error instanceof Error ? error.message : String(error));
});
