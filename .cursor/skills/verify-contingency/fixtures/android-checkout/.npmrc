# Expo SDK 57 backports were published before Expo adopted trusted publishing,
# so nub's no-downgrade trust policy blocks them. Exempt only these exact versions.
trust-policy-exclude=expo@57.0.27,expo-constants@57.0.21,@expo/cli@57.0.28,@expo/config@57.0.10,@expo/config-plugins@57.0.10,@expo/metro-config@57.0.13,babel-preset-expo@57.0.14,expo-asset@57.0.19,expo-modules-autolinking@57.0.14,expo-modules-core@57.0.21,@expo/image-utils@0.11.6,@expo/metro-file-map@57.0.4,@expo/prebuild-config@57.0.17,@expo/require-utils@57.0.6,@expo/router-server@57.0.12
