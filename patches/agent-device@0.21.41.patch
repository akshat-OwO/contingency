+  func chooseTargetedAlertButton(
+    _ alert: RunnerAlert,
+    buttonLabel: String?,
+    buttonIndex: Int?,
+    deadline: Date
+  ) throws -> XCUIElement? {
+    let entries = try readModalValue(deadline: deadline) {
+      alert.actions.map { element in
+        (
+          element: element,
+          label: element.label.trimmingCharacters(in: .whitespacesAndNewlines),
+          actionable: element.exists && element.isEnabled
+        )
+      }
+    }
+    let requestedLabel = buttonLabel?.trimmingCharacters(in: .whitespacesAndNewlines)
+    if let requestedLabel, requestedLabel.isEmpty {
+      return nil
+    }
+    if let index = buttonIndex {
+      guard index >= 0 && index < entries.count else { return nil }
+      let entry = entries[index]
+      guard entry.actionable else { return nil }
+      if let requestedLabel, entry.label != requestedLabel {
+        return nil
+      }
+      return entry.element
+    }
+    guard let requestedLabel else { return nil }
+    let matches = entries.filter { $0.actionable && $0.label == requestedLabel }
+    guard matches.count == 1 else { return nil }
+    return matches[0].element
+  }
+
+  private func validAlertSnapshotRect(_ frame: CGRect) -> SnapshotRect? {
+    guard !frame.isNull, !frame.isEmpty,
+          frame.origin.x.isFinite, frame.origin.y.isFinite,
+          frame.size.width.isFinite, frame.size.height.isFinite,
+          frame.size.width > 0, frame.size.height > 0
+    else {
+      return nil
+    }
+    return SnapshotRect(frame)
+  }
+
+  @MainActor
+  private func revalidateTargetedAlertBeforeDispatch(
+    activeApp: XCUIApplication,
+    action: String,
+    hasExplicitTarget: Bool,
+    buttonLabel: String?,
+    buttonIndex: Int?,
+    chosenLabel: String,
+    expectedMessage: String?,
+    expectedFrame: CGRect,
+    deadline: Date
+  ) -> Bool {
+    guard Date() < deadline else { return false }
+    guard case .resolved(let liveAlert) = resolveAlert(app: activeApp, deadline: deadline) else {
+      return false
+    }
+    do {
+      let liveButton = hasExplicitTarget
+        ? try chooseTargetedAlertButton(
+          liveAlert,
+          buttonLabel: buttonLabel,
+          buttonIndex: buttonIndex,
+          deadline: deadline
+        )
+        : try chooseAlertButton(liveAlert, action: action, deadline: deadline)
+      guard let liveButton else { return false }
+      let snapshot = try readModalValue(deadline: deadline) { () -> (String, CGRect, Bool) in
+        (
+          liveButton.label.trimmingCharacters(in: .whitespacesAndNewlines),
+          liveButton.frame,
+          liveButton.exists && liveButton.isHittable
+        )
+      }
+      guard snapshot.2, snapshot.0 == chosenLabel else { return false }
+      let liveFrame = snapshot.1
+#if !os(tvOS)
+      guard !liveFrame.isNull, !liveFrame.isEmpty,
+            alertFramesMatch(liveFrame, expectedFrame)
+      else {
+        return false
+      }
+#endif
+      if let expected = expectedMessage {
+        let liveTitle = try readModalValue(deadline: deadline) {
+          self.preferredAlertTitle(liveAlert.root, buttons: liveAlert.actions)
+        }
+        guard liveTitle == expected.trimmingCharacters(in: .whitespacesAndNewlines) else {
+          return false
+        }
+      }
+      return true
+    } catch {
+      return false
+    }
+  }
+
+  private func alertFramesMatch(_ a: CGRect, _ b: CGRect) -> Bool {
+    guard a.origin.x.isFinite, a.origin.y.isFinite,
+          a.size.width.isFinite, a.size.height.isFinite,
+          b.origin.x.isFinite, b.origin.y.isFinite,
+          b.size.width.isFinite, b.size.height.isFinite
+    else {
+      return false
+    }
+    let tolerance: CGFloat = 1.0
+    return abs(a.origin.x - b.origin.x) <= tolerance
+      && abs(a.origin.y - b.origin.y) <= tolerance
+      && abs(a.size.width - b.size.width) <= tolerance
+      && abs(a.size.height - b.size.height) <= tolerance
+  }
+
 
 
 
