{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "//#quality": {
      "dependsOn": ["//#lint", "//#format"]
    },
    "//#quality:fix": {
      "dependsOn": ["//#lint:fix", "//#format:fix"],
      "cache": false
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "dependsOn": ["//#lint:fix"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "@contingencyhq/cli#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/apps/web/**",
        "!$TURBO_ROOT$/apps/web/dist/**",
        "!$TURBO_ROOT$/apps/web/node_modules/**",
        "!$TURBO_ROOT$/apps/web/.turbo/**",
        "$TURBO_ROOT$/apps/docs/**",
        "!$TURBO_ROOT$/apps/docs/dist/**",
        "!$TURBO_ROOT$/apps/docs/content/**",
        "!$TURBO_ROOT$/apps/docs/.blume/**",
        "!$TURBO_ROOT$/apps/docs/node_modules/**",
        "!$TURBO_ROOT$/apps/docs/.turbo/**"
      ],
      "outputs": ["dist/**"],
      "env": ["CONTINGENCY_BUILD_IOS_FRAMEBUFFER"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@contingency/docs#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!content/**",
        "!.blume/**",
        "$TURBO_ROOT$/packages/cli/docs/**",
        "$TURBO_ROOT$/packages/cli/resources/**",
        "$TURBO_ROOT$/packages/cli/src/services/doc-topics.ts"
      ],
      "outputs": ["dist/**"]
    },
    "@contingencyhq/cli#dev": {
      "cache": false,
      "dependsOn": ["@contingency/docs#build"],
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "@contingencyhq/cli#test:integration": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}
