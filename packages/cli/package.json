{
  "name": "@contingency/cli",
  "version": "0.0.1",
  "bin": {
    "contingency": "./dist/index.js"
  },
  "files": [
    "assets",
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown && nub run --cwd ../../apps/web build --outDir ../../packages/cli/dist/web --emptyOutDir",
    "check-types": "tsc --noEmit",
    "dev": "nub watch src/index.ts web --no-browser",
    "prepack": "nub run build",
    "test": "nub run build && vitest run"
  },
  "dependencies": {
    "@contingency/protocol": "workspace:*",
    "@effect/platform-node": "^4.0.0-beta.106",
    "effect": "^4.0.0-beta.106",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect",
    "@nubjs/types": "catalog:types",
    "@types/node": "catalog:types",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "catalog:effect"
  }
}
