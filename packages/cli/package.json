{
  "name": "@contingencyhq/cli",
  "version": "0.0.1",
  "repository": {
    "url": "https://github.com/akshat-OwO/contingency"
  },
  "bin": {
    "contingency": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown && node -e \"const fs=require('node:fs');for(const [from,to] of [['skills','dist/skills'],['demo','dist/demo'],['examples','dist/examples'],['onboarding','dist/onboarding']])fs.cpSync(from,to,{recursive:true})\" && nub run --cwd ../../apps/web build --outDir ../../packages/cli/dist/web --emptyOutDir",
    "check-types": "tsc --noEmit",
    "dev": "nub watch src/index.ts web --no-browser",
    "prepack": "nub run build",
    "test": "nub run build && vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@jitl/quickjs-singlefile-mjs-release-asyncify": "0.32.0",
    "axe-core": "^4.13.0",
    "effect": "4.0.0",
    "lighthouse": "^13.5.0",
    "open": "^11.0.0",
    "playwright-core": "1.64.0",
    "puppeteer-core": "^25.12.0",
    "quickjs-emscripten-core": "0.32.0",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@contingency/protocol": "workspace:*",
    "@effect/vitest": "catalog:effect",
    "@nubjs/types": "catalog:types",
    "@types/node": "catalog:types",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "catalog:effect"
  }
}
