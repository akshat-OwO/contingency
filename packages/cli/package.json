{
  "name": "@contingencyhq/cli",
  "version": "0.0.1",
  "repository": {
    "url": "https://github.com/akshat-OwO/contingency",
    "directory": "packages/cli"
  },
  "bin": {
    "contingency": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "config.schema.json",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "nub src/packaging/generate-settings.ts && tsdown && nub src/packaging/vendor-runtime.ts && node -e \"const fs=require('node:fs');for(const [from,to] of [['skills','dist/skills'],['demo','dist/demo'],['examples','dist/examples'],['onboarding','dist/onboarding'],['docs','dist/docs']])fs.cpSync(from,to,{recursive:true})\" && nub run --cwd ../../apps/web build --outDir ../../packages/cli/dist/web --emptyOutDir",
    "check-types": "tsc --noEmit",
    "dev": "nub watch src/index.ts web --no-browser",
    "prepack": "nub run build",
    "test": "nub run build && vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@contingency/protocol": "workspace:*",
    "@effect/platform-node": "4.0.1",
    "@effect/platform-node-shared": "4.0.1",
    "@effect/vitest": "catalog:effect",
    "@nubjs/types": "catalog:types",
    "@opencode/codemode": "2.0.27",
    "@types/node": "catalog:types",
    "agent-device": "0.21.25",
    "axe-core": "^4.13.0",
    "effect": "4.0.1",
    "expo-device-hub": "0.15.3",
    "jsonc-parser": "^3.3.1",
    "lighthouse": "13.5.0",
    "open": "^11.0.0",
    "playwright-core": "1.64.0",
    "puppeteer-core": "25.12.0",
    "smol-toml": "^1.9.0",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "catalog:effect"
  },
  "allowScripts": {
    "node-datachannel": false
  }
}
