{
  "name": "contingency",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalogs": {
      "types": {
        "@types/node": "^26.2.0",
        "@nubjs/types": ">=0.4.13 <=0.7.4"
      },
      "effect": {
        "effect": "^4.0.0-beta.106",
        "@effect/platform-node": "^4.0.0-beta.106",
        "@effect/vitest": "^4.0.0-beta.106",
        "vitest": "^4.1.10"
      }
    },
    "catalog": {
      "typescript": "^7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check-types": "turbo run check-types",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-plugin-react-doctor": "0.9.13",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.11.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.4",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "nub@0.9.0"
}
